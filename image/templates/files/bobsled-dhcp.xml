<?xml version="1.0"?>
<!DOCTYPE service_bundle SYSTEM "/usr/share/lib/xml/dtd/service_bundle.dtd.1">
<!--
    Copyright 2026 Oxide Computer Company
-->

<service_bundle type='manifest' name='oxide-bobsled-dhcp'>

<service name='oxide/bobsled-dhcp' type='service' version='1'>
    <create_default_instance enabled='true' />

    <dependency name='fs-root' grouping='require_all' restart_on='none'
        type='service'>
        <service_fmri value='svc:/system/filesystem/root' />
    </dependency>
    <dependency name='fs-minimal' grouping='require_all' restart_on='none'
        type='service'>
        <service_fmri value='svc:/system/filesystem/minimal' />
    </dependency>

    <!-- The IP interface is plumbed (with IPv6 addrconf) by net-setup: -->
    <dependency name='net-setup' grouping='require_all' restart_on='none'
        type='service'>
        <service_fmri value='svc:/oxide/net-setup:igb' />
    </dependency>

    <!-- Hold back the network milestone (and thus anything that needs a
         working network, including name resolution) until we have tried to
         get a lease. -->
    <dependent name='bobsled-dhcp-network' grouping='optional_all'
        restart_on='none'>
        <service_fmri value='svc:/milestone/network' />
    </dependent>

    <exec_method type='method' name='start'
        exec='/usr/lib/oxide/bobsled-dhcp' timeout_seconds='300' />

    <exec_method type='method' name='stop' exec=':true' timeout_seconds='30' />

    <property_group name='startd' type='framework'>
        <propval name='duration' type='astring' value='transient' />
    </property_group>

    <property_group name='config' type='application'>
        <propval name='link' type='astring' value='igb0' />
        <propval name='wait_seconds' type='count' value='60' />
    </property_group>

    <stability value='Unstable' />

    <template>
        <common_name>
            <loctext xml:lang='C'>bobsled IPv4 DHCP</loctext>
        </common_name>
        <description>
            <loctext xml:lang='C'>configures IPv4 DHCP on the bench sled
                management NIC</loctext>
        </description>
    </template>
</service>

</service_bundle>
